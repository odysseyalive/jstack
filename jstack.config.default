# JStack Default Configuration
#
# Copied to jstack.config on first install. Edit jstack.config (NOT this file)
# to customize. Only DOMAIN and EMAIL are required.

# Base domain that nginx serves and Let's Encrypt certs are issued for.
DOMAIN="example.com"
# Contact email for Let's Encrypt registration and admin alerts.
EMAIL="admin@example.com"

# SSL certificate metadata (for any self-signed fallback certs).
SSL_COUNTRY="US"
SSL_STATE="Oregon"
SSL_CITY="Portland"
SSL_ORGANIZATION="Organization"
SSL_ORG_UNIT="Development"

# Ports
NGINX_PORT=443

# Dry-run and backup
DRY_RUN=false
BACKUP_ENABLED=true

# Debug
DEBUG=false
