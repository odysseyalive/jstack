# ---------------------------------------------------------------------------
# jstack .gitignore
# This repo is deployed in place on each server, so the working tree always
# contains machine-specific state. Anything below is local-only and must never
# reach the shared repo.
# ---------------------------------------------------------------------------

# --- User config and secrets ---
.env
.env.*
!.env.example
.env.secrets
jstack.config
site-templates/*/.env
nginx/htpasswd

# --- TLS material ---
nginx/ssl/*.key
nginx/ssl/*.pem
nginx/ssl/*.crt
nginx/certbot/
nginx/certbot/conf/*

# --- Claude Code configuration (machine-specific) ---
.claude/
# ...except the awareness ledger. Everything else under .claude/ is machine-specific
# and reproducible; the ledger is neither. It is the only durable record of decisions
# and defects whose evidence is gitignored elsewhere in this tree, and the reason it is
# tracked from 2026-09-20 is that PAT-2026-09-19-flat-tar-backup-unrestorable
# established this host has no working backups -- so an untracked ledger had no second
# copy anywhere. Git is now that copy. Each path is re-included in turn because git does
# not descend into an excluded directory, so a lone negation for the leaf would not fire.
!.claude/
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/awareness-ledger/
.claude/skills/awareness-ledger/*
!.claude/skills/awareness-ledger/ledger/
.claude-backups/
.censusignore
CLAUDE.md

# --- Server-specific compose overrides ---
docker-compose.override.yml
docker-compose.*.local.yml

# --- Generated nginx site configs (written by the install script) ---
nginx/conf.d/*.conf

# --- Live fail2ban ban list (rewritten on every ban/unban by jstack-nginx-geo) ---
nginx/conf.d/f2b-banned.geo

# --- Pre-change vhost backups (written by scripts/core/apply_vhost_change.sh) ---
# Copies of generated per-host vhosts, so they carry the same host-specific
# content nginx/conf.d/*.conf does and must not reach the public repository.
nginx/conf.d-backups/

# --- Generated sites, runtime state, and output ---
apps/
sites/
data/
logs/
backups/
tests/unit/

# --- Local backup / scratch files ---
# Ad-hoc copies made before edits on a live server, e.g.
#   docker-compose.yml.bak-2026-08-27
#   nginx/nginx.conf.watchman-bak-20260619
*.bak
*.bak-*
*-bak-*
*.backup
*.orig
*.rej
*.save
*.old
*~
*.tmp
*.swp
*.swo
.#*
#*#
*.local
*.local.*

# --- Docker artifacts ---
**/docker-volumes/
**/backup/
**/.docker/

# --- Node.js artifacts ---
node_modules/
dist/
.next/
*.log

# --- Build / test output ---
coverage/
*.out

# --- Editor and OS files ---
.vscode/
.idea/
.DS_Store
Thumbs.db
