# Ignore user config and secrets
.env
.env.secrets
jstack.config
site-templates/*/.env
nginx/ssl/*.key

# Claude Code configuration (machine-specific)
.claude/
CLAUDE.md

# Service data and credentials
data/
nginx/htpasswd

# Supabase edge functions (separate repo)
supabase/

# Custom apps (separate repos)
apps/

# Ignore generated nginx configs (created dynamically by install script)
nginx/conf.d/*.conf
nginx/certbot/

# Node.js artifacts
node_modules/
dist/
*.log

# Docker artifacts
**/docker-volumes/
**/backup/
**/.docker/

# System files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/

# Build/test output
coverage/
*.out

# Ignore generated sites and runtime/output
sites/
logs/
backups/
tests/unit/

# Add more patterns as needed during development
.crush.json
.github
.specify
specs/
tests/
CRUSH.md
