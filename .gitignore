# ---------------------------------------------------------------------------
# jstack .gitignore
# This repo is deployed in place on each server, so the working tree always
# contains machine-specific state. Anything below is local-only and must never
# reach the shared repo.
# ---------------------------------------------------------------------------

# --- User config and secrets ---
.env
.env.*
!.env.example
.env.secrets
jstack.config
site-templates/*/.env
nginx/htpasswd

# --- TLS material ---
nginx/ssl/*.key
nginx/ssl/*.pem
nginx/ssl/*.crt
nginx/certbot/
nginx/certbot/conf/*

# --- Claude Code configuration (machine-specific) ---
.claude/
.claude-backups/
.censusignore
CLAUDE.md

# --- Server-specific compose overrides ---
docker-compose.override.yml
docker-compose.*.local.yml

# --- Generated nginx site configs (written by the install script) ---
nginx/conf.d/*.conf

# --- Generated sites, runtime state, and output ---
apps/
sites/
data/
logs/
backups/
tests/unit/

# --- Local backup / scratch files ---
# Ad-hoc copies made before edits on a live server, e.g.
#   docker-compose.yml.bak-2026-08-27
#   nginx/nginx.conf.watchman-bak-20260619
*.bak
*.bak-*
*-bak-*
*.backup
*.orig
*.rej
*.save
*.old
*~
*.tmp
*.swp
*.swo
.#*
#*#
*.local
*.local.*

# --- Docker artifacts ---
**/docker-volumes/
**/backup/
**/.docker/

# --- Node.js artifacts ---
node_modules/
dist/
.next/
*.log

# --- Build / test output ---
coverage/
*.out

# --- Editor and OS files ---
.vscode/
.idea/
.DS_Store
Thumbs.db
